# OpenHands agent-server running NATIVELY on the host as mab776 (no container).
# Rendered by install.sh into /home/mab776/openhands-host/env (chmod 600 - it holds the backend key)
# and loaded by ~/.config/systemd/user/openhands-agent-server.service.
#
# Enter the URL + key ONCE PER BROWSER in Agent Canvas > Manage Backends:
#   name: Host (mab776)   URL: http://192.168.0.70:7300   API key: the OH_SESSION_API_KEYS_0 value
OH_SESSION_API_KEYS_0=__KEY__
OH_SECRET_KEY=__SECRET__
OH_CONVERSATIONS_PATH=/home/mab776/openhands-host/state/conversations
OH_BASH_EVENTS_DIR=/home/mab776/openhands-host/state/bash_events
# No openvscode-server on the host; the canvas container still has its own at /vscode.
OH_ENABLE_VSCODE=false
OH_WEB_URL=http://192.168.0.70:7300
# The BROWSER calls this backend directly (not through the :3003 proxy), so its origin must be
# allowed. DOCKER_HOST_ADDR whitelists the hostname on any port; the explicit entries are belt+braces.
OH_ALLOW_CORS_ORIGINS_0=http://192.168.0.70:3003
OH_ALLOW_CORS_ORIGINS_1=http://10.229.135.70:3003
DOCKER_HOST_ADDR=192.168.0.70
# canvas_ui_tool.py copied out of the agent-canvas image: registers `canvas_ui` and the builtin
# FinishTool the canvas frontend expects (see the note at the bottom of that file).
OH_EXTRA_PYTHON_PATH=/home/mab776/openhands-host/tools
OH_ACP_SKILL_SOURCING=openhands_managed
OPENHANDS_SUPPRESS_BANNER=1
DO_NOT_TRACK=1
# 2026-09-22: "Branch from here" forks a conversation WITHOUT its LLM api_key (base_state.json has
# api_key: null) → every turn died with "The api_key client option must be set". llama.cpp needs no
# key, but the openai client refuses an empty one; this env fallback is what it reads when the
# conversation carries none.
OPENAI_API_KEY=not-needed
